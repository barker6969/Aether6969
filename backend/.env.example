# Copy this file to .env and fill in your values

# Required: random secret string for JWT signing (generate with: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here

# Required: MongoDB connection string
MONGO_URL=mongodb://localhost:27017
DB_NAME=aether

# Required: Stripe secret key (from https://dashboard.stripe.com/apikeys)
STRIPE_API_KEY=sk_test_...

# Optional: Stripe webhook secret (from https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: Admin account credentials (defaults shown)
ADMIN_EMAIL=admin@aether.dev
ADMIN_PASSWORD=admin123

# Optional: Founder account credentials
BRAIDEN_EMAIL=braiden@aether.dev
BRAIDEN_PASSWORD=founder_braiden_2026
