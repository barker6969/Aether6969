{
  "name": "aether-desktop",
  "version": "0.1.0",
  "description": "Aether Repair Tool — native desktop wrapper with bundled CLI bridge.",
  "private": true,
  "scripts": {
    "prepare:cli": "node scripts/prepare-cli-sidecar.js",
    "dev": "node scripts/prepare-cli-sidecar.js && tauri dev",
    "build": "node scripts/prepare-cli-sidecar.js && tauri build",
    "build:msi": "node scripts/prepare-cli-sidecar.js && tauri build --bundles msi",
    "build:nsis": "node scripts/prepare-cli-sidecar.js && tauri build --bundles nsis",
    "build:dmg": "node scripts/prepare-cli-sidecar.js && tauri build --bundles dmg",
    "build:appimage": "node scripts/prepare-cli-sidecar.js && tauri build --bundles appimage"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.5"
  },
  "engines": {
    "node": ">=18"
  }
}
